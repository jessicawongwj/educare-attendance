{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/cron-report", "schedule": "0 22 1,15 * *" }
  ],
  "redirects": [
    { "source": "/", "destination": "/educare-portal", "permanent": false },
    { "source": "/trainer-portal", "destination": "/educare-portal", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/educare-portal",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/checkin",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/trainer-portal",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
